load("@rules_apple//apple:apple.bzl", "apple_static_xcframework")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:defs.bzl", "cc_library", "objc_library")

filegroup(
    name = "render_test_data",
    srcs = glob(
        ["render-tests/**"],
        exclude = [
            "render-tests/**/actual.png",
            "render-tests/**/diff.png",
            "render-tests/cache.db",
            "render-tests/results/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "render_test_plugin",
    srcs = ["render-tests/register.cpp"],
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [
        ":heatmap_core",
        "//:render_test_registry",
    ],
)

cc_library(
    name = "render_test_plugin_metal",
    srcs = ["render-tests/register.cpp"],
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [
        ":HeatmapLayer",
        "//:render_test_registry",
    ],
)

cc_library(
    name = "heatmap_core",
    srcs = ["shared/cpp/heatmap_layer.cpp"],
    hdrs = [
        "shared/include/heatmap_layer.hpp",
        "shared/include/heatmap_shader_sources.hpp",
    ],
    copts = [
        "-std=c++20",
        "-fvisibility=hidden",
        "-DMLN_HEATMAP_PLUGIN_VERSION=\\\"$(plugin_version)\\\"",
    ],
    includes = ["shared/include"],
    visibility = ["//visibility:public"],
    deps = ["@maplibre//:plugin-api"],
)

objc_library(
    name = "HeatmapLayer",
    srcs = [
        "ios/src/HeatmapLayer.mm",
        "shared/cpp/heatmap_layer.cpp",
    ],
    hdrs = [
        "ios/include/HeatmapLayer/HeatmapLayer.h",
        "shared/include/heatmap_layer.hpp",
        "shared/include/heatmap_shader_sources.hpp",
    ],
    copts = [
        "-std=c++20",
        "-fobjc-arc",
        "-fvisibility=hidden",
        "-DMLN_HEATMAP_PLUGIN_VERSION=\\\"$(plugin_version)\\\"",
    ],
    includes = [
        "ios/include",
        "shared/include",
    ],
    module_name = "HeatmapLayer",
    sdk_frameworks = ["Foundation"],
    visibility = ["//visibility:public"],
    deps = ["@maplibre//:plugin-api"],
)

apple_bundle_version(
    name = "HeatmapLayer.version",
    build_label_pattern = "{version}",
    build_version = "{version}",
    capture_groups = {"version": "\\d+\\.\\d+\\.\\d+"},
    fallback_build_label = "0.1.0",
    short_version_string = "{version}",
)

apple_static_xcframework(
    name = "HeatmapLayer.xcframework",
    bundle_id = "org.maplibre.plugins.heatmap-layer",
    bundle_name = "HeatmapLayer",
    ios = {
        "simulator": ["arm64", "x86_64"],
        "device": ["arm64"],
    },
    minimum_os_versions = {"ios": "14.0"},
    public_hdrs = ["ios/include/HeatmapLayer/HeatmapLayer.h"],
    version = ":HeatmapLayer.version",
    visibility = ["//visibility:public"],
    deps = [":HeatmapLayer"],
)
