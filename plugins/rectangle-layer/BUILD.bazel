load("@rules_apple//apple:apple.bzl", "apple_static_xcframework")
load("@rules_apple//apple:macos.bzl", "macos_command_line_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "objc_library")

cc_library(
    name = "rectangle_core",
    srcs = ["shared/cpp/rectangle_layer.cpp"],
    hdrs = ["shared/include/rectangle_layer.hpp"],
    copts = [
        "-std=c++20",
        "-fvisibility=hidden",
        "-DMLN_RECTANGLE_PLUGIN_VERSION=\\\"$(plugin_version)\\\"",
    ],
    includes = ["shared/include"],
    visibility = ["//visibility:public"],
    deps = ["@maplibre//:plugin-api"],
)

objc_library(
    name = "RectangleLayer",
    srcs = [
        "ios/src/RectangleLayer.mm",
        "shared/cpp/rectangle_layer.cpp",
    ],
    hdrs = [
        "ios/include/RectangleLayer/RectangleLayer.h",
        "shared/include/rectangle_layer.hpp",
    ],
    copts = [
        "-std=c++20",
        "-fobjc-arc",
        "-fvisibility=hidden",
        "-DMLN_RECTANGLE_PLUGIN_VERSION=\\\"$(plugin_version)\\\"",
    ],
    includes = [
        "ios/include",
        "shared/include",
    ],
    module_name = "RectangleLayer",
    sdk_frameworks = ["Foundation"],
    visibility = ["//visibility:public"],
    deps = ["@maplibre//:plugin-api"],
)

apple_bundle_version(
    name = "RectangleLayer.version",
    build_label_pattern = "{version}",
    build_version = "{version}",
    capture_groups = {"version": "\\d+\\.\\d+\\.\\d+"},
    fallback_build_label = "0.1.0",
    short_version_string = "{version}",
)

apple_static_xcframework(
    name = "RectangleLayer.xcframework",
    bundle_id = "org.maplibre.plugins.rectangle-layer",
    bundle_name = "RectangleLayer",
    ios = {
        "simulator": ["arm64", "x86_64"],
        "device": ["arm64"],
    },
    minimum_os_versions = {"ios": "14.0"},
    public_hdrs = ["ios/include/RectangleLayer/RectangleLayer.h"],
    version = ":RectangleLayer.version",
    visibility = ["//visibility:public"],
    deps = [":RectangleLayer"],
)

cc_test(
    name = "render_tests",
    srcs = ["render-tests/main.cpp"],
    args = [
        "--manifestPath",
        "$(location render-tests/manifest.json)",
    ],
    data = glob(["render-tests/**"]),
    tags = ["no-sandbox"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":rectangle_core",
        "@maplibre//render-test:render-test-srcs",
        "@maplibre//vendor:maplibre-native-base",
    ],
)

objc_library(
    name = "render_tests_metal_lib",
    srcs = ["render-tests/main.cpp"],
    data = glob(["render-tests/**"]),
    deps = [
        ":rectangle_core",
        "@maplibre//render-test:render-test-srcs",
        "@maplibre//vendor:maplibre-native-base",
    ],
)

macos_command_line_application(
    name = "render_tests_metal",
    minimum_deployment_os_version = "14.0",
    minimum_os_version = "14.0",
    visibility = ["//visibility:public"],
    deps = [":render_tests_metal_lib"],
)
