load("@rules_apple//apple:apple.bzl", "apple_static_xcframework")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:defs.bzl", "cc_library", "objc_library")

filegroup(
    name = "render_test_data",
    srcs = glob(
        ["render-tests/**"],
        exclude = [
            "render-tests/**/actual.png",
            "render-tests/**/diff.png",
            "render-tests/cache.db",
            "render-tests/results/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "render_test_plugin",
    srcs = ["render-tests/register.cpp"],
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [
        ":gltf_core",
        "//:render_test_registry",
    ],
)

cc_library(
    name = "render_test_plugin_metal",
    srcs = ["render-tests/register.cpp"],
    alwayslink = True,
    visibility = ["//visibility:public"],
    deps = [
        ":GltfLayer",
        "//:render_test_registry",
    ],
)

cc_library(
    name = "gltf_core",
    srcs = ["shared/cpp/gltf_layer.cpp"],
    hdrs = ["shared/include/gltf_layer.hpp"],
    copts = [
        "-std=c++20",
        "-fvisibility=hidden",
        "-DMLN_GLTF_PLUGIN_VERSION=\"$(plugin_version)\"",
    ],
    includes = ["shared/include"],
    visibility = ["//visibility:public"],
    deps = [
        ":tinygltf",
        "@maplibre//:plugin-api",
    ],
)

objc_library(
    name = "GltfLayer",
    srcs = [
        "ios/src/GltfLayer.mm",
        "shared/cpp/gltf_layer.cpp",
    ],
    hdrs = [
        "ios/include/GltfLayer/GltfLayer.h",
        "shared/include/gltf_layer.hpp",
    ],
    copts = [
        "-std=c++20",
        "-fobjc-arc",
        "-fvisibility=hidden",
        "-DMLN_GLTF_PLUGIN_VERSION=\\\"$(plugin_version)\\\"",
    ],
    includes = [
        "ios/include",
        "shared/include",
    ],
    module_name = "GltfLayer",
    sdk_frameworks = [
        "Foundation",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":tinygltf",
        "@maplibre//:plugin-api",
    ],
)

apple_bundle_version(
    name = "GltfLayer.version",
    build_label_pattern = "{version}",
    build_version = "{version}",
    capture_groups = {"version": "\\d+\\.\\d+\\.\\d+"},
    fallback_build_label = "0.1.0",
    short_version_string = "{version}",
)

apple_static_xcframework(
    name = "GltfLayer.xcframework",
    bundle_id = "org.maplibre.plugins.gltf-layer",
    bundle_name = "GltfLayer",
    ios = {
        "simulator": [
            "arm64",
            "x86_64",
        ],
        "device": ["arm64"],
    },
    minimum_os_versions = {"ios": "14.0"},
    public_hdrs = ["ios/include/GltfLayer/GltfLayer.h"],
    version = ":GltfLayer.version",
    visibility = ["//visibility:public"],
    deps = [":GltfLayer"],
)

filegroup(
    name = "example_assets",
    srcs = glob(["examples/android/assets/*.json"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tinygltf",
    srcs = ["vendor/tinygltf/tiny_gltf.cc"],
    hdrs = [
        "vendor/tinygltf/json.hpp",
        "vendor/tinygltf/stb_image.h",
        "vendor/tinygltf/stb_image_write.h",
        "vendor/tinygltf/tiny_gltf.h",
    ],
    includes = ["vendor/tinygltf"],
    visibility = ["//visibility:public"],
)
