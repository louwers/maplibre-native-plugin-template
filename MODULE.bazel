module(name = "maplibre_native_plugin_template")

bazel_dep(name = "maplibre", version = "0.0.0")
bazel_dep(name = "aspect_rules_js", version = "2.8.1")
bazel_dep(name = "apple_support", version = "1.24.5", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_apple", version = "4.3.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_nodejs", version = "6.6.2")

# Toolchain registrations in dependency modules are not inherited. Register an
# Apple-aware C/C++ toolchain here so plugin Metal render tests can compile the
# Objective-C++ portions of MapLibre when it is a local_path_override.
apple_cc_configure = use_extension(
    "@build_bazel_apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc", "local_config_apple_cc_toolchains")
register_toolchains("@local_config_apple_cc_toolchains//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "fill_extrusion_shadows_release",
    build_file_content = """
load("@rules_apple//apple:apple.bzl", "apple_static_xcframework_import")

apple_static_xcframework_import(
    name = "FillExtrusionShadows",
    xcframework_imports = glob(["FillExtrusionShadows.xcframework/**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "d732e39a47bdca084189cd4f27f091fb2e9f7a979f59d79aa95e20a74bfb6d53",
    urls = [
        "https://github.com/louwers/maplibre-native-plugin-template/releases/download/0.0.2/FillExtrusionShadows-0.0.2.xcframework.zip",
    ],
)

# Development and CI place this repository directly inside or next to the
# matching MapLibre Native checkout.
local_path_override(
    module_name = "maplibre",
    path = "../maplibre-native",
)

local_path_override(
    module_name = "maplibre-tile-spec",
    path = "../maplibre-native/vendor/maplibre-tile-spec",
)

# MapLibre Native currently pins a cxx.rs release newer than the Bazel Central
# Registry entry. Overrides must be repeated by the root module.
git_override(
    module_name = "cxx.rs",
    remote = "https://github.com/dtolnay/cxx.git",
    tag = "1.0.157",
)
